# Supabase project "Purview US East" (org: PurviewOps, ref mpwhtwflbehvmhtcssdn). The
# intake route writes the raw payload to pv_intake_raw with the service role
# key, so this file is server side only. Neither var is NEXT_PUBLIC_ and
# neither should become one.
#
# The service role key is the one under Project Settings > API Keys > secret.
# Not the publishable / anon key: pv_intake_raw has RLS on with no policies, so
# anon is refused and the write fails.
SUPABASE_URL=https://mpwhtwflbehvmhtcssdn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Intake notification (interim) ---------------------------------------
# Tells you a submission arrived so you are not checking Supabase by hand.
# Notification is n8n's job per section 7 step 10 of the setup doc; delete
# this var and app/notify.ts when n8n takes over.
#
# A Discord webhook: Server Settings > Integrations > Webhooks > New Webhook,
# then Copy Webhook URL. It is a bearer credential in URL form, so treat it
# like a password: anyone holding it can post to that channel. Rotate by
# deleting the webhook and making another.
#
# Leave it unset and the notifier logs that it skipped and does nothing else.
# Capture is unaffected either way.
DISCORD_WEBHOOK_URL=

# --- Site assistant -------------------------------------------------------
# Where app/api/chat/route.ts forwards a chat turn after it has written the
# user turn to pv_chat_log. n8n owns the system prompt, the model call, the
# trigger, and the write of the assistant turn, per purview_assistant_spec.md.
#
# Server side only, and deliberately not a constant in app/chat.ts: that file
# is imported by the widget, so anything in it ships to the browser.
#
# Leave it unset and the route logs that it has no answer to give and returns
# a failure. The question is still written to pv_chat_log first, which is the
# whole point of the ordering.
#
# The widget itself is off until CHAT_WEBHOOK_URL in app/chat.ts is set to
# '/api/chat'. Set both or neither.
N8N_CHAT_WEBHOOK_URL=
