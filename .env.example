# Supabase project "Purview" (org: PurviewOps, ref vdrlqtivdcaephzuqhbp). The
# intake route writes the raw payload to pv_intake_raw with the service role
# key, so this file is server side only. Neither var is NEXT_PUBLIC_ and
# neither should become one.
#
# The service role key is the one under Project Settings > API Keys > secret.
# Not the publishable / anon key: pv_intake_raw has RLS on with no policies, so
# anon is refused and the write fails.
SUPABASE_URL=https://vdrlqtivdcaephzuqhbp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Intake notification (interim) ---------------------------------------
# Tells you a submission arrived so you are not checking Supabase by hand.
# Notification is n8n's job per section 7 step 10 of the setup doc; delete
# these three and app/notify.ts when n8n takes over.
#
# Gmail SMTP, chosen because it adds no account and no third party holding
# the leads. GMAIL_APP_PASSWORD is a 16 character App Password from
# https://myaccount.google.com/apppasswords, not the account password. It
# requires 2 Step Verification to be on. Your normal password will not work.
#
# Leave any of the three unset and the notifier logs that it skipped and does
# nothing else. Capture is unaffected either way.
NOTIFY_TO=
GMAIL_USER=
GMAIL_APP_PASSWORD=
